# GPU-инференс: PyTorch CUDA из базового образа.

FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

ENV PIP_NO_CACHE_DIR=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH=/opt/conda/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV TORCHINDUCTOR_CACHE_DIR=/tmp/torch-inductor-cache

WORKDIR /app

RUN pip install --root-user-action=ignore --upgrade pip setuptools wheel

COPY requirements-docker-cuda.txt .
RUN pip install --root-user-action=ignore -r requirements-docker-cuda.txt

COPY app/ ./app/
COPY config.yaml .
COPY pytest.ini .
COPY tests/ ./tests/
COPY ci/ ./ci/

RUN mkdir -p model

EXPOSE 5000

CMD ["python", "-m", "app.main", "--host", "0.0.0.0", "--port", "5000"]
